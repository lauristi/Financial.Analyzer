      "post": {
        "tags": [
          "Clipboard"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Transmition"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/Transmition"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/Transmition"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/clipboard/get": {
      "get": {
        "tags": [
          "Clipboard"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/ErrorSimulator/exception": {
      "get": {
        "tags": [
          "ErrorSimulator"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/ErrorSimulator/business-error": {
      "get": {
        "tags": [
          "ErrorSimulator"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/ErrorSimulator/validation-errors": {
      "get": {
        "tags": [
          "ErrorSimulator"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/statement/uploadStatement": {
      "post": {
        "tags": [
          "Statement"
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "files": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "format": "binary"
                    }
                  }
                }
              },
              "encoding": {
                "files": {
                  "style": "form"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/statement/uploadExpenses": {
      "post": {
        "tags": [
          "Statement"
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              },
              "encoding": {
                "file": {
                  "style": "form"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
