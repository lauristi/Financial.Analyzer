{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "NLog": {
    "targets": {
      "file": {
        "type": "File",
        "fileName": "GlobalLog.log",
        "layout": "${longdate}|${level:uppercase=true}|${message} ${exception:format=tostring}"
      }
    },
    "rules": [
      {
        "logger": "*",
        "minLevel": "Debug",
        "writeTo": "file"
      }
    ]
  },

  "AllowedHosts": "*",

  "ConnectionSettings": {
    "ApiBaseAddress": "",
    "BindPort": 0
  }
}