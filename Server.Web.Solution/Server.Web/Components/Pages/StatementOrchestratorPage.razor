@page "/"
@using Server.Web.Components.Shared
@rendermode InteractiveServer

<header>
    <p></p>
</header>

<div class="container-fluid py-4">

    @* Alert global *@
    <div class="row mb-3">
        <div class="col-12">
            <UXMessageComponent />
        </div>
    </div>

    @* Navegação por Abas - Lógica controlada pelo activeTab *@
    <ul class="nav nav-tabs mb-4" role="tablist">
        <li class="nav-item">
            <button class="nav-link @(activeTab == "main" ? "active" : "")"
                    @onclick='() => ChangeTab("main")'
                    type="button">
                <i class="bi bi-graph-up-arrow me-2"></i>Análise Financeira
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(activeTab == "debug" ? "active" : "")"
                    @onclick='() => ChangeTab("debug")'
                    type="button">
                <i class="bi bi-terminal me-2"></i>Simulador de Erros
            </button>
        </li>
    </ul>

    <div class="tab-content">
        @if (activeTab == "main")
        {
            @* Aba Principal *@
            <div class="tab-pane fade show active">
                <div class="row g-4">
                    @* Coluna de Uploads *@
                    <div class="col-lg-4 col-md-5">
                        <div class="d-flex flex-column gap-3">
                            <div class="card shadow-sm border-0">
                                <div class="card-header bg-primary text-white py-1 small fw-bold text-uppercase">Importação de Extratos</div>
                                <div class="card-body p-3">
                                    <div class="upload-container-fluid">
                                        <UploadStatementComponent OnUpload="ProcessStatementUpload" />
                                    </div>
                                </div>
                            </div>

                            <div class="card shadow-sm border-0">
                                <div class="card-header bg-warning text-dark py-1 small fw-bold text-uppercase">Importação de Despesas</div>
                                <div class="card-body p-3">
                                    <div class="upload-container-fluid">
                                        <UploadExpenseComponent OnUpload="ProcessExpenseUpload" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    @* Coluna do Dashboard *@
                    <div class="col-lg-8 col-md-7">
                        <div class="card shadow-sm border-0 h-100">
                            <div class="card-header bg-dark text-white py-1 small fw-bold text-center">
                                PAINEL DE RESULTADOS
                            </div>
                            <div class="card-body bg-white p-4">
                                <FinancialDashboardComponent Data="@statementResult.Dashboard" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
        else if (activeTab == "debug")
        {
            @* Aba de Debug *@
            <div class="tab-pane fade show active">
                <div class="card border-danger shadow-sm">
                    <div class="card-body bg-white rounded">
                        <ErrorSimulatorComponent />
                    </div>
                </div>
            </div>
        }
    </div>

    @* Rodapé com versão *@
    <div class="mt-4 border-top pt-2 d-flex justify-content-end">
        <span class="badge bg-light text-dark border">v1.0.0</span>
    </div>

</div>